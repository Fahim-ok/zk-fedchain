# Copy to .env and fill in. Never commit .env.

# Ethereum Sepolia testnet RPC (e.g. from Alchemy or Infura) and a TEST-ONLY private key
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Optional: permissioned Hyperledger Besu network for a consortium deployment
BESU_RPC_URL=

# Set to true to print a gas table when running tests
REPORT_GAS=false

# Deployment parameters (optional)
NORM_BOUND_SQ=1099511627776
GENESIS_MODEL_HASH=
GENESIS_MODEL_CID=

# Off-chain nodes
IPFS_API_URL=http://127.0.0.1:5001
